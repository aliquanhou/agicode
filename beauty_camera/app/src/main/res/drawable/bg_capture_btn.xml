<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈霓虹光晕 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF7B2C" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <!-- 中圈 -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="66dp"
                android:height="66dp" />
        </shape>
    </item>
    <!-- 内圈 -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="#FF7B2C" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <!-- 最内圈 -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#FF416C" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
            <size
                android:width="52dp"
                android:height="52dp" />
        </shape>
    </item>
</layer-list>
